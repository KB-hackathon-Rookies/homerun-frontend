# .env 로 복사해서 쓴다.
#   cp .env.example .env

# 백엔드 주소. 로컬에서 homerun-backend 를 띄우면 8080 이다.
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Firebase 웹 앱 설정.
# 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → 웹 앱 → firebaseConfig
#
# 비밀이 아니다. SPA 라 빌드할 때 번들에 그대로 박힌다. 그래서 배포 환경이
# 여럿이면 환경마다 빌드 인자로 넘겨야 한다.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# 웹 푸시 인증서의 **공개키**.
# 콘솔 → 프로젝트 설정 → 클라우드 메시징 → 웹 구성 → 웹 푸시 인증서
#
# 공개키만 여기 넣는다. 비공개키와 서비스 계정(FIREBASE_CREDENTIALS)은
# 백엔드에만 있어야 한다 — 그건 푸시를 보내는 권한이다.
NUXT_PUBLIC_FIREBASE_VAPID_KEY=
